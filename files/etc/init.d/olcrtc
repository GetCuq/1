#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

EXTRA_COMMANDS="apply_routes"
EXTRA_HELP="    apply_routes  Re-apply egress-interface policy routing (used by hotplug)"

SERVICE_NAME="olcrtc"
LOGTAG="olcrtc"
BINARY="/usr/bin/olcrtc"
CONFIG_DIR="/etc/olcrtc"
CONFIG_PATH="${CONFIG_DIR}/client.yaml"

# --- Egress-interface policy routing (wan_interface) ---
# Dedicated unprivileged user so olcrtc's traffic can be matched by UID.
OLCRTC_USER="olcrtc"
OLCRTC_UID="8377"
OLCRTC_GROUP="olcrtc"
OLCRTC_GID="8377"
# Routing table / fwmark / rule priority. The table id is kept <= 255 because
# busybox's `ip` only supports the legacy 8-bit table field. Chosen to avoid
# clashing with common Podkop defaults.
RT_TABLE="194"
FW_MARK="0x4f43"
RULE_PRIO="30000"
NFT_TABLE_NAME="olcrtc"
HOTPLUG_SCRIPT="/etc/hotplug.d/iface/30-olcrtc-pbr"

is_loopback_host() {
    case "$1" in
        127.0.0.1|localhost|::1)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

yaml_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

yaml_write_line() {
    printf '%s\n' "$1" >> "$CONFIG_PATH"
}

validate_config() {
    local auth_provider="$1"
    local transport="$2"
    local room_id="$3"
    local key="$4"
    local socks_host="$5"
    local socks_user="$6"
    local socks_pass="$7"
    local data_dir="$8"

    [ -x "$BINARY" ] || {
        logger -t "$LOGTAG" "error: binary not found or not executable: $BINARY"
        return 1
    }

    case "$auth_provider" in
        jitsi|telemost|wbstream)
            ;;
        *)
            logger -t "$LOGTAG" "error: unsupported auth.provider: $auth_provider"
            return 1
            ;;
    esac

    case "$transport" in
        datachannel|vp8channel|seichannel|videochannel)
            ;;
        *)
            logger -t "$LOGTAG" "error: unsupported net.transport: $transport"
            return 1
            ;;
    esac

    [ -n "$room_id" ] || {
        logger -t "$LOGTAG" "error: room.id is required"
        return 1
    }

    [ -n "$data_dir" ] || {
        logger -t "$LOGTAG" "error: data dir is required"
        return 1
    }

    printf '%s' "$key" | grep -Eq '^[0-9A-Fa-f]{64}$' || {
        logger -t "$LOGTAG" "error: crypto.key must be a 64-char hex string"
        return 1
    }

    if [ "$auth_provider" = "telemost" ] && [ "$transport" = "datachannel" ]; then
        logger -t "$LOGTAG" "error: telemost + datachannel is unsupported"
        return 1
    fi

    if [ "$auth_provider" = "telemost" ] && [ "$transport" = "seichannel" ]; then
        logger -t "$LOGTAG" "error: telemost + seichannel is unsupported"
        return 1
    fi

    if ! is_loopback_host "$socks_host" && { [ -z "$socks_user" ] || [ -z "$socks_pass" ]; }; then
        logger -t "$LOGTAG" "error: non-loopback SOCKS host requires socks.user and socks.pass"
        return 1
    fi

    return 0
}

write_yaml_config() {
    local auth_provider="$1"
    local transport="$2"
    local room_id="$3"
    local key="$4"
    local socks_host="$5"
    local socks_port="$6"
    local socks_user="$7"
    local socks_pass="$8"
    local dns="$9"
    local data_dir="${10}"
    local debug="${11}"
    local ffmpeg_bin="${12}"
    local vp8_fps="${13}"
    local vp8_batch="${14}"
    local sei_fps="${15}"
    local sei_batch="${16}"
    local sei_frag="${17}"
    local sei_ack_ms="${18}"
    local video_codec="${19}"
    local video_w="${20}"
    local video_h="${21}"
    local video_fps="${22}"
    local video_bitrate="${23}"
    local video_hw="${24}"
    local video_qr_recovery="${25}"
    local video_qr_size="${26}"
    local video_tile_module="${27}"
    local video_tile_rs="${28}"

    mkdir -p "$CONFIG_DIR" "$data_dir"
    : > "$CONFIG_PATH"

    yaml_write_line "mode: cnc"
    yaml_write_line "auth:"
    yaml_write_line "  provider: \"$(yaml_escape "$auth_provider")\""
    yaml_write_line "room:"
    yaml_write_line "  id: \"$(yaml_escape "$room_id")\""
    yaml_write_line "crypto:"
    yaml_write_line "  key: \"$(yaml_escape "$key")\""
    yaml_write_line "net:"
    yaml_write_line "  transport: \"$(yaml_escape "$transport")\""
    yaml_write_line "  dns: \"$(yaml_escape "$dns")\""
    yaml_write_line "socks:"
    yaml_write_line "  host: \"$(yaml_escape "$socks_host")\""
    yaml_write_line "  port: ${socks_port}"
    yaml_write_line "  user: \"$(yaml_escape "$socks_user")\""
    yaml_write_line "  pass: \"$(yaml_escape "$socks_pass")\""
    yaml_write_line "vp8:"
    yaml_write_line "  fps: ${vp8_fps}"
    yaml_write_line "  batch_size: ${vp8_batch}"
    yaml_write_line "sei:"
    yaml_write_line "  fps: ${sei_fps}"
    yaml_write_line "  batch_size: ${sei_batch}"
    yaml_write_line "  fragment_size: ${sei_frag}"
    yaml_write_line "  ack_timeout_ms: ${sei_ack_ms}"
    yaml_write_line "video:"
    yaml_write_line "  width: ${video_w}"
    yaml_write_line "  height: ${video_h}"
    yaml_write_line "  fps: ${video_fps}"
    yaml_write_line "  bitrate: \"$(yaml_escape "$video_bitrate")\""
    yaml_write_line "  hw: \"$(yaml_escape "$video_hw")\""
    yaml_write_line "  codec: \"$(yaml_escape "$video_codec")\""
    yaml_write_line "  qr_recovery: \"$(yaml_escape "$video_qr_recovery")\""
    yaml_write_line "  qr_size: ${video_qr_size}"
    yaml_write_line "  tile_module: ${video_tile_module}"
    yaml_write_line "  tile_rs: ${video_tile_rs}"
    yaml_write_line "data: \"$(yaml_escape "$data_dir")\""
    yaml_write_line "ffmpeg: \"$(yaml_escape "$ffmpeg_bin")\""
    yaml_write_line "debug: $( [ "$debug" = "1" ] && printf true || printf false )"
}

# Create the dedicated unprivileged user/group (idempotent).
ensure_user() {
    if ! grep -q "^${OLCRTC_GROUP}:" /etc/group 2>/dev/null; then
        [ -n "$(tail -c1 /etc/group 2>/dev/null)" ] && echo >> /etc/group
        echo "${OLCRTC_GROUP}:x:${OLCRTC_GID}:" >> /etc/group
    fi
    if ! grep -q "^${OLCRTC_USER}:" /etc/passwd 2>/dev/null; then
        [ -n "$(tail -c1 /etc/passwd 2>/dev/null)" ] && echo >> /etc/passwd
        echo "${OLCRTC_USER}:x:${OLCRTC_UID}:${OLCRTC_GID}:olcrtc:/var/lib/olcrtc:/bin/false" >> /etc/passwd
    fi
}

# Resolve a logical OpenWrt interface to its L3 device and gateway.
# Sets globals IFACE_DEV and IFACE_GW. Returns non-zero if no device yet.
resolve_iface() {
    local name="$1" status
    IFACE_DEV=""
    IFACE_GW=""
    status="$(ubus call network.interface."$name" status 2>/dev/null)" || return 1
    [ -n "$status" ] || return 1
    IFACE_DEV="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)"
    IFACE_GW="$(printf '%s' "$status" | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop' 2>/dev/null | head -n1)"
    [ -n "$IFACE_GW" ] || IFACE_GW="$(printf '%s' "$status" | jsonfilter -e '@.route[*].nexthop' 2>/dev/null | head -n1)"
    [ -n "$IFACE_DEV" ]
}

# Write a hotplug helper so the route table is refreshed when the egress
# interface comes up / changes IP (e.g. DHCP renew on a phone hotspot).
install_hotplug() {
    local wan_if="$1"
    mkdir -p /etc/hotplug.d/iface
    cat > "$HOTPLUG_SCRIPT" <<EOF
#!/bin/sh
# Auto-generated by /etc/init.d/olcrtc — do not edit.
# Refreshes olcrtc egress policy routing when the chosen interface changes.
[ "\$ACTION" = ifup ] || [ "\$ACTION" = ifupdate ] || exit 0
[ "\$INTERFACE" = "$wan_if" ] || exit 0
/etc/init.d/olcrtc apply_routes
EOF
    chmod 644 "$HOTPLUG_SCRIPT"
}

# Remove all policy-routing state (rule, table, nft chain, hotplug helper).
clear_pbr() {
    while ip rule del fwmark "$FW_MARK" lookup "$RT_TABLE" 2>/dev/null; do :; done
    ip route flush table "$RT_TABLE" 2>/dev/null
    nft delete table inet "$NFT_TABLE_NAME" 2>/dev/null
    rm -f "$HOTPLUG_SCRIPT" 2>/dev/null
}

# Build (or rebuild) the policy routing for the configured egress interface.
apply_pbr() {
    local wan_if uid DROP_RULE NAT_CHAIN

    config_load olcrtc
    config_get wan_if config wan_interface ''

    # No interface selected -> tear everything down.
    [ -n "$wan_if" ] || { clear_pbr; return 0; }

    if ! command -v nft >/dev/null 2>&1; then
        logger -t "$LOGTAG" "pbr: nft not found (fw4 required), skipping egress routing"
        return 0
    fi

    # Keep the hotplug refresher in place even if the iface is down right now.
    install_hotplug "$wan_if"

    uid="$(id -u "$OLCRTC_USER" 2>/dev/null)" || uid="$OLCRTC_UID"
    [ -n "$uid" ] || uid="$OLCRTC_UID"

    # Policy rule: marked packets look up the dedicated table (before main).
    ip rule del fwmark "$FW_MARK" lookup "$RT_TABLE" 2>/dev/null
    ip rule add fwmark "$FW_MARK" lookup "$RT_TABLE" priority "$RULE_PRIO"

    # Default route in the dedicated table + the kill-switch drop rule both
    # depend on whether the egress interface is up right now.
    ip route flush table "$RT_TABLE" 2>/dev/null
    if resolve_iface "$wan_if"; then
        if [ -n "$IFACE_GW" ]; then
            ip route replace default via "$IFACE_GW" dev "$IFACE_DEV" table "$RT_TABLE" 2>/dev/null \
                || ip route replace default via "$IFACE_GW" dev "$IFACE_DEV" onlink table "$RT_TABLE"
        else
            ip route replace default dev "$IFACE_DEV" table "$RT_TABLE"
        fi
        # Up: drop anything from olcrtc that would leave via any device other
        # than the chosen egress (loopback stays allowed for the local SOCKS).
        DROP_RULE="meta skuid ${uid} oifname != \"${IFACE_DEV}\" oifname != \"lo\" drop"
        # Source address is picked at connect() time (before the mark exists),
        # so it is the wrong (main) IP. Masquerade on egress rewrites it to the
        # interface address; otherwise the upstream drops the foreign source.
        NAT_CHAIN="    chain nat_out {
        type nat hook postrouting priority srcnat; policy accept;
        meta skuid ${uid} oifname \"${IFACE_DEV}\" masquerade
    }"
        logger -t "$LOGTAG" "pbr: olcrtc(uid=$uid) -> table $RT_TABLE via ${IFACE_DEV}${IFACE_GW:+ gw $IFACE_GW} (iface $wan_if)"
    else
        # Down: drop all non-loopback olcrtc traffic (kill-switch, no leak).
        DROP_RULE="meta skuid ${uid} oifname != \"lo\" drop"
        NAT_CHAIN=""
        logger -t "$LOGTAG" "pbr: interface '$wan_if' down; olcrtc traffic dropped (kill-switch) until it comes up"
    fi

    # Mark olcrtc's traffic for routing. Use a high priority so our mark is the
    # last one written before the routing decision — Podkop/fw4 restore connmark
    # in OUTPUT and would otherwise clobber it. The kill-switch runs after the
    # mark chain (and thus after the re-route) so it sees the final oif.
    nft delete table inet "$NFT_TABLE_NAME" 2>/dev/null
    nft -f - <<EOF
table inet ${NFT_TABLE_NAME} {
    chain mark_output {
        type route hook output priority 300; policy accept;
        meta skuid ${uid} meta mark set ${FW_MARK}
    }
    chain killswitch {
        type filter hook output priority 350; policy accept;
        ${DROP_RULE}
    }
${NAT_CHAIN}
}
EOF
}

# rc extra command, also invoked from the hotplug helper.
apply_routes() {
    pidof olcrtc >/dev/null 2>&1 || return 0
    apply_pbr
}

start_service() {
    local auth_provider transport room_id key
    local wan_interface
    local socks_host socks_port socks_user socks_pass dns data_dir debug ffmpeg_bin auto_reconnect
    local vp8_fps vp8_batch
    local sei_fps sei_batch sei_frag sei_ack_ms
    local video_codec video_w video_h video_fps video_bitrate video_hw
    local video_qr_recovery video_qr_size video_tile_module video_tile_rs

    config_load olcrtc
    config_get auth_provider      config auth_provider      'jitsi'
    config_get transport          config transport          'datachannel'
    config_get room_id            config room_id            ''
    config_get key                config key                ''
    config_get socks_host         config socks_host         '127.0.0.1'
    config_get socks_port         config socks_port         '1080'
    config_get socks_user         config socks_user         ''
    config_get socks_pass         config socks_pass         ''
    config_get dns                config dns                '1.1.1.1:53'
    config_get data_dir           config data_dir           '/var/lib/olcrtc'
    config_get debug              config debug              '0'
    config_get auto_reconnect     config auto_reconnect     '1'
    config_get wan_interface      config wan_interface      ''
    config_get ffmpeg_bin         config ffmpeg             'ffmpeg'
    config_get vp8_fps            config vp8_fps            '60'
    config_get vp8_batch          config vp8_batch          '64'
    config_get sei_fps            config sei_fps            '60'
    config_get sei_batch          config sei_batch          '64'
    config_get sei_frag           config sei_frag           '900'
    config_get sei_ack_ms         config sei_ack_ms         '2000'
    config_get video_codec        config video_codec        'qrcode'
    config_get video_w            config video_w            '1920'
    config_get video_h            config video_h            '1080'
    config_get video_fps          config video_fps          '30'
    config_get video_bitrate      config video_bitrate      '2M'
    config_get video_hw           config video_hw           'none'
    config_get video_qr_recovery  config video_qr_recovery  'low'
    config_get video_qr_size      config video_qr_size      '0'
    config_get video_tile_module  config video_tile_module  '4'
    config_get video_tile_rs      config video_tile_rs      '20'

    validate_config \
        "$auth_provider" "$transport" "$room_id" "$key" \
        "$socks_host" "$socks_user" "$socks_pass" "$data_dir" || return 1

    write_yaml_config \
        "$auth_provider" "$transport" "$room_id" "$key" \
        "$socks_host" "$socks_port" "$socks_user" "$socks_pass" \
        "$dns" "$data_dir" "$debug" "$ffmpeg_bin" \
        "$vp8_fps" "$vp8_batch" \
        "$sei_fps" "$sei_batch" "$sei_frag" "$sei_ack_ms" \
        "$video_codec" "$video_w" "$video_h" "$video_fps" "$video_bitrate" "$video_hw" \
        "$video_qr_recovery" "$video_qr_size" "$video_tile_module" "$video_tile_rs"

    # When an egress interface is selected, run olcrtc as a dedicated user so
    # its traffic can be matched by UID for policy routing.
    if [ -n "$wan_interface" ]; then
        ensure_user
        chown -R "$OLCRTC_USER":"$OLCRTC_GROUP" "$data_dir" 2>/dev/null
        chown "$OLCRTC_USER":"$OLCRTC_GROUP" "$CONFIG_PATH" 2>/dev/null
        chmod 600 "$CONFIG_PATH" 2>/dev/null
    fi

    logger -t "$LOGTAG" "starting client: provider=$auth_provider transport=$transport socks=${socks_host}:${socks_port}${wan_interface:+ egress=$wan_interface}"

    procd_open_instance
    procd_set_param command "$BINARY" "$CONFIG_PATH"
    # Drop privileges to the dedicated user so its traffic can be matched by
    # UID. (busybox has no `su`, so we rely on procd's user/group params; they
    # work now that ensure_user reliably creates the account.)
    if [ -n "$wan_interface" ]; then
        procd_set_param user "$OLCRTC_USER"
        procd_set_param group "$OLCRTC_GROUP"
    fi
    [ "$auto_reconnect" = "1" ] && procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Set up (or clear) egress-interface policy routing.
    apply_pbr

    setup_cron
}

stop_service() {
    logger -t "$LOGTAG" "stopping client"
    clear_pbr
}

# Map hour-interval to a cron time expression
_cron_expr() {
    case "$1" in
        1)  printf '0 * * * *'   ;;
        3)  printf '0 */3 * * *' ;;
        6)  printf '0 */6 * * *' ;;
        12) printf '0 */12 * * *';;
        *)  printf '0 3 * * *'   ;;  # 24 h or anything else → daily at 03:00
    esac
}

# Add or remove the olcrtc-autoupdate cron entry based on UCI settings
setup_cron() {
    local auto_update interval cron_file expr
    config_load olcrtc
    config_get auto_update  config auto_update          "0"
    config_get interval     config auto_update_interval "24"

    cron_file="/etc/crontabs/root"
    touch "$cron_file"

    # Remove any existing olcrtc-autoupdate line first
    grep -v 'olcrtc-autoupdate' "$cron_file" > /tmp/_cron_tmp 2>/dev/null \
        && mv /tmp/_cron_tmp "$cron_file"

    if [ "$auto_update" = "1" ]; then
        expr="$(_cron_expr "$interval")"
        printf '%s /usr/bin/olcrtc-autoupdate\n' "$expr" >> "$cron_file"
        logger -t "$LOGTAG" "auto-update cron set: $expr"
    else
        logger -t "$LOGTAG" "auto-update cron disabled"
    fi

    /etc/init.d/cron reload 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "olcrtc"
}

reload_service() {
    setup_cron
    # Only restart the binary if it is currently running.
    # This prevents UCI config saves from waking a deliberately-stopped service.
    if pidof olcrtc >/dev/null 2>&1; then
        stop
        start
    fi
}
